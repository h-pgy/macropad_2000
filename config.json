{
  "layout": {
    "slash_key": "KEY_RO"
  },
  "profiles": [
    {
      "name": "Claude",
      "match": [
        {
          "app": "org.gnome.Terminal.desktop",
          "title_regex": "^[◐◑✳🤖]"
        }
      ],
      "keys": {
        "F13": {
          "label": "voz",
          "action": "combo",
          "combo": "alt+k",
          "mode": "toggle",
          "double": {
            "label": "limpar voz",
            "action": "combo",
            "combo": "ctrl+u"
          }
        },
        "F14": {
          "label": "submeter",
          "action": "combo",
          "combo": "enter"
        },
        "F15": {
          "label": "backspace",
          "action": "combo",
          "combo": "backspace",
          "mode": "while_held"
        },
        "F16": {
          "label": "clear",
          "action": "text",
          "text": "/clear"
        },
        "F17": {
          "label": "interrupt",
          "action": "combo",
          "combo": "ctrl+c"
        },
        "F18": {
          "label": "Global",
          "action": "profile",
          "profile": "Global"
        },
        "F19": {
          "label": "←",
          "action": "combo",
          "combo": "left"
        },
        "F20": {
          "label": "effort",
          "action": "text",
          "text": "/effort\n"
        },
        "F21": {
          "label": "→",
          "action": "combo",
          "combo": "right"
        }
      },
      "chords": {
        "F13+F14": {
          "label": "model",
          "action": "text",
          "text": "/model\n"
        }
      }
    },
    {
